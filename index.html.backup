<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HWR FB2 Stundenplan</title>
  <style>
    :root {
      color-scheme: light;
      font-family: Inter, system-ui, sans-serif;
      background: #f4f6fb;
      color: #111827;
      line-height: 1.5;
    }
    * { box-sizing: border-box; }
    body { margin: 0; padding: 0 1rem 3rem; }
    header { max-width: 1100px; margin: auto; padding: 2rem 0 1rem; }
    h1 { margin: 0 0 0.5rem; font-size: clamp(2.2rem, 3vw, 3rem); }
    p { margin: 0 1rem 1.5rem 0; color: #4b5563; }
    .controls { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin-bottom: 1.5rem; }
    .controls label { display: inline-flex; gap: 0.75rem; align-items: center; }
    select, .meta { border: 1px solid #d1d5db; border-radius: 0.75rem; background: #ffffff; color: #111827; padding: 0.85rem 1rem; font-size: 1rem; }
    button { border: 1px solid #d1d5db; border-radius: 0.75rem; background: #ffffff; color: #111827; padding: 0.85rem 1rem; font-size: 1rem; cursor: pointer; }
    button:hover { border-color: #9ca3af; }
    #resetCache { background: #f3f4f6; border-color: #d1d5db; color: #6b7280; font-size: 0.9rem; }
    #resetCache:hover { background: #e5e7eb; border-color: #9ca3af; }
    .week-controls { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
    .week-label { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.85rem 1rem; border-radius: 0.75rem; border: 1px solid #d1d5db; background: #fff; color: #111827; font-size: 0.95rem; }
    .status { color: #6b7280; font-size: 0.95rem; }
    .schedule-table-container { overflow-x: auto; }
    .schedule-grid-wrapper { display: grid; grid-template-columns: 80px 1fr; gap: 0; border: 1px solid #e5e7eb; border-radius: 0.5rem; overflow: hidden; --slot-height: 90px; --day-height: 810px; --time-column-width: 80px; }
    .time-column { display: block; width: var(--time-column-width); background: #f9fafb; border-right: 1px solid #e5e7eb; padding: 0; }
    .time-slot { display: flex; align-items: center; justify-content: center; height: var(--slot-height); padding: 0.75rem 0.5rem; font-size: 0.85rem; color: #6b7280; text-align: center; border-bottom: 1px solid #e5e7eb; font-weight: 500; }
    .days-grid { display: grid; grid-template-columns: repeat(5, minmax(110px, 1fr)); gap: 0; }
    .days-grid.with-saturday { grid-template-columns: repeat(6, minmax(100px, 1fr)); }
    .day-column-grid { border-right: 1px solid #e5e7eb; position: relative; background: #ffffff; min-width: 100px; }
    .day-column-grid.current-day { border-color: #df8379; box-shadow: 0 10px 30px rgba(223, 131, 121, 0.15); background: linear-gradient(135deg, rgba(223, 131, 121, 0.18) 0%, rgba(223, 131, 121, 0.08) 50%, rgba(223, 131, 121, 0.04) 100%); }
    .day-column-grid:last-child { border-right: none; }
    .day-header-grid { background: #eff6ff; padding: 0.65rem 0.5rem; text-align: center; border-bottom: 1px solid #e5e7eb; position: sticky; top: 0; z-index: 2; font-size: 0.82rem; }
    .day-header-grid.current-day { background: linear-gradient(180deg, rgba(223, 131, 121, 0.25) 0%, rgba(223, 131, 121, 0.12) 100%); border-bottom-color: #df8379; }
    .day-content { position: relative; height: var(--day-height); background: repeating-linear-gradient(transparent 0, transparent calc(var(--slot-height) - 1px), rgba(148,163,184,0.08) calc(var(--slot-height) - 1px), rgba(148,163,184,0.08) var(--slot-height)); }
    .event-item { position: absolute; left: 0.35rem; right: 0.35rem; padding: 0.4rem 0.45rem; border-radius: 0.4rem; background: #f8fafc; border: 1px solid #e5e7eb; font-size: 0.78rem; line-height: 1.2; overflow: hidden; cursor: pointer; transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease; }
    .event-item.online { background: linear-gradient(180deg, #eff6ff 0%, #f8fafc 100%); border-color: #bfdbfe; }
    .event-item-time { font-weight: 600; color: #1d4ed8; font-size: 0.72rem; }
    .event-item-title { font-weight: 700; margin: 0.2rem 0 0; font-size: 0.8rem; }
    .event-item-meta { font-size: 0.68rem; color: #475569; margin-top: 0.18rem; white-space: normal; word-break: break-word; }
    .event-item-compact { font-size: 0.72rem; }
    .event-item-compact.expanded { overflow: visible; background-color: rgba(248, 250, 252, 0.95); box-shadow: 0 10px 30px rgba(15, 23, 42, 0.15); transform: translateY(-2px); z-index: 10; }
    .event-item-compact.expanded .event-item-meta { display: block; max-height: 1000px; opacity: 1; }
    .event-item-compact:hover:not(.expanded) { transform: translateY(-1px); }
    .day-header-grid.free-day { background: linear-gradient(180deg, #dcfce7 0%, #f0fdf4 100%); }
    .day-name-grid { font-size: 0.95rem; font-weight: 600; }
    .day-date-grid { font-size: 0.9rem; color: #4b5563; }
    .day-content { position: relative; height: var(--day-height); background: repeating-linear-gradient(transparent 0, transparent calc(var(--slot-height) - 1px), rgba(148,163,184,0.08) calc(var(--slot-height) - 1px), rgba(148,163,184,0.08) var(--slot-height)); }
    .event-item { position: absolute; left: 0.5rem; right: 0.5rem; padding: 0.6rem; border-radius: 0.5rem; background: #f8fafc; border: 1px solid #e5e7eb; font-size: 0.9rem; line-height: 1.25; overflow: hidden; cursor: pointer; transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
    }
    .event-item.online { background: linear-gradient(180deg, #eff6ff 0%, #f8fafc 100%); border-color: #bfdbfe; }
    .event-item-time { font-weight: 600; color: #1d4ed8; }
    .event-item-title { font-weight: 700; margin: 0.25rem 0 0; }
    .event-item-meta { font-size: 0.75rem; color: #475569; margin-top: 0.2rem; white-space: normal; word-break: break-word; }
    .event-item-compact { font-size: 0.75rem; }
    .event-item-compact .event-item-meta { display: none; max-height: 0; opacity: 0; transition: max-height 0.2s ease, opacity 0.2s ease; }
    .event-item-compact.expanded { overflow: visible; background-color: rgba(248, 250, 252, 0.95); box-shadow: 0 10px 30px rgba(15, 23, 42, 0.15); transform: translateY(-2px); z-index: 10; }
    .event-item-compact.expanded .event-item-meta { display: block; max-height: 1000px; opacity: 1; }
    .event-item-compact:hover:not(.expanded) { transform: translateY(-1px); }
    .event-item:focus-within { outline: 2px solid rgba(59, 130, 246, 0.5); }
    .free-indicator { padding: 1.5rem; text-align: center; color: #16a34a; font-weight: 600; }
    .schedule-table { display: none; }
    .event-card.online { background: linear-gradient(180deg, #eff6ff 0%, #f8fafc 100%); border-color: #bfdbfe; }
    .event-title { margin: 0; font-weight: 700; font-size: 1rem; }
    .event-meta { font-size: 0.95rem; color: #4b5563; display: grid; gap: 0.25rem; }
    .event-type { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.85rem; font-weight: 600; color: #2563eb; }
    .pill { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.2rem 0.55rem; border-radius: 999px; background: #e0f2fe; color: #055fa6; font-size: 0.8rem; }
    .note { color: #6b7280; font-size: 0.9rem; margin: 0; }
    .empty { color: #6b7280; font-style: italic; margin: 0; }
    .footer-note { margin-top: 1rem; color: #6b7280; }
    @media (max-width: 900px) {
      .schedule-table { min-width: 100%; }
      .controls { flex-direction: column; align-items: stretch; }
      .controls label, .week-controls, .status { width: 100%; }
      .week-controls { justify-content: space-between; margin-top: 0.5rem; }
      .week-label { width: 100%; text-align: center; }
      .schedule-grid-wrapper { grid-template-columns: 70px 1fr; }
      .time-column { display: block; }
      .time-slot { font-size: 0.75rem; }
      .day-column-grid { border-right: 1px solid #e5e7eb; min-width: 0; }
      .day-column-grid + .day-column-grid { border-top: none; }
      .day-content { padding: 0.75rem; }
      .days-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
      .schedule-table-container { overflow-x: hidden; }
      .event-item { padding: 0.4rem 0.35rem; font-size: 0.75rem; }
    }
    @media (max-width: 640px) {
      body { padding: 0 0.75rem 2rem; }
      header { padding: 1.3rem 0 0.75rem; }
      header h1 { font-size: 2.3rem; }
      .controls {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 0.85rem;
        background: #ffffff;
        border: 1px solid rgba(148, 163, 184, 0.35);
        border-radius: 1.25rem;
        padding: 1rem;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
      }
      .controls label, .week-controls, .status { width: 100%; }
      .controls label { flex-direction: column; align-items: stretch; gap: 0.5rem; }
      .meta { display: block; width: auto; }
      select, button, .week-label { width: 100%; }
      select { border-radius: 0.95rem; }
      button { width: 100%; justify-content: center; }
      .week-controls {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 0.75rem;
        align-items: center;
      }
      .week-controls button { min-width: 0; }
      .week-label { white-space: normal; text-align: center; font-size: 0.95rem; padding: 0.85rem 1rem; }
      .status { padding: 0.35rem 0.75rem; font-size: 0.92rem; background: #f8fafc; border-radius: 0.9rem; border: 1px solid #e2e8f0; }
      .schedule-grid-wrapper {
        display: block;
        border: none;
        background: transparent;
        box-shadow: none;
      }
      .time-column { display: none; }
      .days-grid {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .day-column-grid {
        display: block;
        border: none;
        background: #ffffff;
        border-radius: 1.25rem;
        box-shadow: 0 16px 36px rgba(15, 23, 42, 0.07);
        overflow: hidden;
      }
      .day-column-grid.current-day { background: linear-gradient(135deg, rgba(223, 131, 121, 0.2) 0%, rgba(223, 131, 121, 0.1) 50%, rgba(223, 131, 121, 0.05) 100%); box-shadow: 0 16px 36px rgba(223, 131, 121, 0.15); }
      .day-column-grid:last-child { border-right: none; }
      .day-header-grid {
        position: relative;
        top: auto;
        z-index: auto;
        text-align: left;
        display: grid;
        gap: 0.1rem;
        padding: 1rem;
        background: linear-gradient(180deg, #eef7ff 0%, #f8fbff 100%);
        border-bottom: 1px solid #e5e7eb;
      }
      .day-header-grid.current-day { background: linear-gradient(180deg, rgba(223, 131, 121, 0.28) 0%, rgba(223, 131, 121, 0.12) 100%); border-bottom-color: #df8379; }
      .day-name-grid { font-size: 1rem; }
      .day-date-grid { font-size: 0.95rem; }
      .day-content {
        position: static;
        height: auto;
        padding: 1rem;
        background: #ffffff;
        background-image: none;
        min-height: 0;
      }
      .event-item {
        position: static;
        width: 100%;
        top: auto;
        height: auto;
        margin: 0 0 0.85rem;
        right: auto;
        left: auto;
        border-radius: 1rem;
        padding: 1rem;
        border: 1px solid #e2e8f0;
        background: #f8fbff;
      }
      .event-item:last-child { margin-bottom: 0; }
      .event-item-time { font-size: 0.95rem; }
      .event-item-title { font-size: 1rem; }
      .event-item-meta { font-size: 0.85rem; }
      .event-item-compact .event-item-meta { display: block; max-height: none; opacity: 1; }
      .event-item-compact.expanded { transform: none; box-shadow: none; }
      .free-indicator { padding: 1rem; text-align: left; }
    }
    @media (max-width: 420px) {
      h1 { font-size: clamp(1.9rem, 7vw, 2.3rem); }
      .controls { gap: 0.6rem; padding: 0.85rem; }
      .week-controls { grid-template-columns: 1fr; }
      .week-label { padding: 0.9rem 0.85rem; }
      .day-header-grid { padding: 0.95rem 0.9rem; }
      .day-content { padding: 0.85rem; }
      .event-item { padding: 0.95rem; font-size: 0.88rem; }
    }
  </style>
</head>
<body>
  <header>
    <h1>HWR FB2 Stundenplan</h1>
    <p>Automatisch generierte Wochenansicht aus ICS-Dateien. Wähle einen Stundenplan und navigiere Woche für Woche.</p>
    <div class="controls">
      <label>
        <span class="meta">Semester:</span>
        <select id="semesterSelect"></select>
      </label>
      <label>
        <span class="meta">Fach:</span>
        <select id="facultySelect"></select>
      </label>
      <label>
        <span class="meta">Kurs:</span>
        <select id="courseSelect"></select>
      </label>
      <button id="resetCache" type="button" title="Auswahl zurücksetzen">↻ Cache löschen</button>
      <div class="week-controls">
        <button id="prevWeek" type="button">← Vorwoche</button>
        <span class="week-label" id="weekLabel">KW …</span>
        <button id="nextWeek" type="button">Nächste Woche →</button>
      </div>
      <div class="status" id="status"></div>
    </div>
  </header>

  <main>
    <div class="schedule-table-container">
      <div class="schedule-grid-wrapper">
        <div class="time-column" id="timeColumn"></div>
        <div class="days-grid" id="daysGrid"></div>
      </div>
    </div>
    <p class="footer-note">Wenn deine Vorlesungen anders angezeigt werden sollen, kann ich die Tabelle weiter anpassen (z. B. nur Montags–Freitags, 30-Minuten-Zeitslots oder farbliche Blöcke).</p>
  </main>

  <script>
    const dayNames = ['Sonntag', 'Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag'];

    function getMonday(date) {
      const copy = new Date(date);
      const day = copy.getDay();
      const diff = (day + 6) % 7;
      copy.setDate(copy.getDate() - diff);
      copy.setHours(0, 0, 0, 0);
      return copy;
    }

    function addDays(date, days) {
      const copy = new Date(date);
      copy.setDate(copy.getDate() + days);
      return copy;
    }

    function formatTime(isoString) {
      if (!isoString) return '–';
      const date = new Date(isoString);
      return date.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
    }

    function formatDateShort(date) {
      return date.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit' });
    }

    function formatDateLabel(date) {
      return date.toLocaleDateString('de-DE', { weekday: 'long', day: '2-digit', month: '2-digit' });
    }

    function stripTitlePrefix(title) {
      return title.replace(/^\s*\d+\s*-\s*/, '').trim();
    }

    function getWeekLabel(startDate) {
      const endDate = addDays(startDate, 6);
      return `${formatDateShort(startDate)} – ${formatDateShort(endDate)}`;
    }

    function getLocalDateKey(date) {
      return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
    }

    function groupEventsByDay(events) {
      return events.reduce((grouped, event) => {
        const date = new Date(event.start);
        const key = getLocalDateKey(date);
        grouped[key] = grouped[key] || [];
        grouped[key].push(event);
        return grouped;
      }, {});
    }

    function mergeConsecutiveEvents(dayEvents) {
      if (dayEvents.length <= 1) return dayEvents;
      
      const merged = [];
      let currentGroup = [dayEvents[0]];
      let currentPauseMinutes = parsePauseMinutes(dayEvents[0]);
      
      const finalizeGroup = () => {
        if (currentGroup.length > 1) {
          merged.push({
            ...currentGroup[0],
            end: currentGroup[currentGroup.length - 1].end,
            _merged: true,
            _pauseMinutes: currentPauseMinutes
          });
        } else {
          merged.push({
            ...currentGroup[0],
            _pauseMinutes: 0
          });
        }
      };
      
      for (let i = 1; i < dayEvents.length; i++) {
        const prev = currentGroup[currentGroup.length - 1];
        const curr = dayEvents[i];
        const gapMs = new Date(curr.start).getTime() - new Date(prev.end).getTime();
        const gapMinutes = Math.round(gapMs / (1000 * 60));
        const pauseFromDesc = parsePauseMinutes(curr);

        if (prev.title === curr.title && gapMs >= 0) {
          currentGroup.push(curr);
          currentPauseMinutes += gapMinutes + pauseFromDesc;
        } else {
          finalizeGroup();
          currentGroup = [curr];
          currentPauseMinutes = pauseFromDesc;
        }
      }
      
      finalizeGroup();
      return merged;
    }

    function parsePauseMinutes(event) {
      if (!event || !event.rawDescription) return 0;
      const raw = event.rawDescription || '';
      // Look for patterns like "Pause: inkl. 15 min Pause" or "Pause: 45min" or "45 min Pause"
      const m = raw.match(/Pause:\s*(?:inkl\.|inkl)?\s*(\d{1,3})\s*min/i) || raw.match(/(\d{1,3})\s*min\s*Pause/i);
      if (m && m[1]) return parseInt(m[1], 10) || 0;
      return 0;
    }

    function renderSchedule(data, selectedSource, referenceDate) {
      const events = selectedSource ? data.events.filter((event) => event.sourceId === selectedSource) : [];
      const grouped = groupEventsByDay(events);
      const weekStart = getMonday(referenceDate);
      
      // Prüfe auf Samstag-Events in dieser Woche
      const saturdayKey = getLocalDateKey(addDays(weekStart, 5));
      const hasSaturdayEvents = grouped[saturdayKey] && grouped[saturdayKey].length > 0;
      
      // Bestimme Anzahl der Spalten: 5 (Mo-Fr) oder 6 (Mo-Sa wenn Events)
      const numDays = hasSaturdayEvents ? 6 : 5;
      const weekDays = Array.from({ length: numDays }, (_, index) => addDays(weekStart, index));
      
      // Finde Min/Max Uhrzeiten basierend auf den Ereignissen der angezeigten Woche
      let minHour = 6, maxHour = 18;
      const displayedEvents = [];
      weekDays.forEach((d) => {
        const key = getLocalDateKey(d);
        (grouped[key] || []).forEach(e => displayedEvents.push(e));
      });
      displayedEvents.forEach((event) => {
        if (event.start) {
          const s = new Date(event.start);
          const e = new Date(event.end);
          const startHour = Math.floor(s.getHours() + s.getMinutes() / 60);
          const endHour = Math.ceil(e.getHours() + e.getMinutes() / 60);
          minHour = Math.min(minHour, startHour);
          maxHour = Math.max(maxHour, endHour);
        }
      });
      // Fallback/constraints
      minHour = Math.max(0, Math.min(12, minHour));
      maxHour = Math.max(minHour + 4, Math.min(24, maxHour));
      
      const timeColumn = document.getElementById('timeColumn');
      const daysGrid = document.getElementById('daysGrid');
      
      // Setze Grid-Klasse
      daysGrid.className = hasSaturdayEvents ? 'days-grid with-saturday' : 'days-grid';
      
      const totalHours = Math.max(4, maxHour - minHour);
      const slotHeightPx = 100;
      const dayHeightPx = totalHours * slotHeightPx;
      const wrapper = document.querySelector('.schedule-grid-wrapper');
      if (wrapper) {
        wrapper.style.setProperty('--slot-height', `${slotHeightPx}px`);
        wrapper.style.setProperty('--day-height', `${dayHeightPx}px`);
      }

      const timeSlots = [];
      for (let h = minHour; h <= maxHour; h++) timeSlots.push(h);
      timeColumn.innerHTML = timeSlots.map((hour) => `<div class="time-slot">${String(hour).padStart(2, '0')}:00</div>`).join('');
      
      const todayKey = getLocalDateKey(new Date());
      const shouldScrollToToday = window.innerWidth <= 800;
      
      // Tage rendern